# Normalize line endings so files don't churn between OSes.
# Prevents the composer.json LF->CRLF flip that happened during the org rename.
* text=auto eol=lf

*.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.pot text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf

# Keep dev files out of the Composer dist. Bedrock installs this plugin from a
# tagged GitHub zipball (`preferred-install: dist`), and GitHub's archive honors
# export-ignore — so what is listed here never lands in web/app/plugins/.
# bin/build-release.sh applies the equivalent excludes to the standalone zip.
/tests            export-ignore
/docs             export-ignore
/bin              export-ignore
/.github          export-ignore
/.claude          export-ignore
/.phpunit.cache   export-ignore
/phpcs.xml        export-ignore
/phpunit.xml      export-ignore
/.php-cs-fixer.php export-ignore
/composer.lock    export-ignore
/.gitignore       export-ignore
/.gitattributes   export-ignore
